			transform-origin: center center

		.banner-stage__image--fading
			transition: opacity var(--banner-fade-duration, 1200ms) var(--m3e-easing-standard)

		.banner-stage__image--active
			opacity: 1

		// happycola：动态横幅的视频层，叠在静态图上面；媒体层自成一层，视频的 z-index 不会盖到文字上
		.banner-stage__media
			z-index: 0

		.banner-stage__video
			position: absolute
			inset: 0
			width: 100%
			height: 100%
			object-fit: cover
			opacity: 0
			pointer-events: none

		.banner-stage__video--fading
			transition: opacity var(--banner-fade-duration, 1200ms) var(--m3e-easing-standard)

		.banner-stage__video--shown
			opacity: 1

		// happycola：右下角署名，放在底部波浪上面（波浪顶上还有一层半透明的浪花，再往上让一点）
		.banner-stage__credit
			position: absolute
			z-index: 2
			right: var(--m3e-space-6)
			bottom: calc(clamp(var(--m3e-space-10), 8vh, calc(var(--m3e-space-10) + var(--m3e-space-8))) + var(--m3e-space-6))
			max-width: calc(100% - var(--m3e-space-12))
			font: var(--m3e-type-label-small)
			letter-spacing: 0.02em
			color: white
			text-decoration: none
			text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6)
			opacity: 0.6
			transition: opacity var(--m3e-duration-short, 200ms) var(--m3e-easing-standard)

			&:hover,
			&:focus-visible
				opacity: 1
				text-decoration: underline

		.banner-stage__scrim
			z-index: 1
			background: unquote("rgb(0 0 0 / calc(var(--banner-dim-opacity) * 0.55))")
			pointer-events: none

		:global(html.dark) .banner-stage__scrim
			background: unquote("rgb(0 0 0 / var(--banner-dim-opacity))")

		.banner-stage__copy
			z-index: 2
			display: none
			flex-direction: column
			align-items: center
			justify-content: center
			padding: 4rem 1.5rem 2rem
			color: white
			text-align: center
			text-shadow: 0 2px 12px rgba(0, 0, 0, 0.48)
			pointer-events: none

		.banner-stage__copy h1,
		.banner-stage__context-title
			margin: 0
			font: var(--m3e-type-headline-medium)
			font-weight: 700
			letter-spacing: 0
			line-height: 1.1

		.banner-stage__copy h1,
		.banner-stage__context-title
			font-size: clamp(2.5rem, 5rem, 5rem)

