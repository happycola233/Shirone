				display: none

		.banner-stage__media,
		.banner-stage__scrim,
		.banner-stage__copy
			position: absolute
			inset: 0

		.banner-stage__image
			position: absolute
			inset: 0
			width: 100%
			height: 100%
			object-fit: cover
			opacity: 0
